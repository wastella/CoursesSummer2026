// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Inc16(in=prevout, out=added);
    Mux16(a=prevout, b=added, sel=inc, out=gate1);
    Mux16(a=gate1, b=in, sel=load, out=gate2);
    Mux16(a=gate2, b=false, sel=reset, out=input);
    //Or(a=reset, b=load, out=or1);
    //Or(a=or1, b=inc, out=toload);
    Register(in=input, load=true, out=out, out=prevout);
}